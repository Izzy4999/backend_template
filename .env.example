# Copy this file to .env and fill in the values
# The server will refuse to start if any required variable is missing

NODE_ENV=development
PORT=4000

# JWT tokens
JWT_SECRET=
REFRESH_SECRET=

# Auth session mode: "single" = one refresh token per user (logout logs out everywhere), "multi" = multiple refresh tokens (logout only revokes current session)
AUTH_SESSION_MODE=single

# Email (used by utils/mailer.ts)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
